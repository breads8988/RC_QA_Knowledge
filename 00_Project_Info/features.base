filters:
  and:
    - note.type == "feature" || note.type == "tc"
properties:
  note.code:
    displayName: Code
  note.platform:
    displayName: Platform
  note.actor:
    displayName: Actor
  note.domain:
    displayName: Domain
  note.entity:
    displayName: Entity
  note.status:
    displayName: Status
  note.tc_total:
    displayName: TCs
  note.tc_automated:
    displayName: Automated
  file.name:
    displayName: Note
views:
  - type: table
    name: All features
    filters:
      and:
        - note.type == "feature"
    groupBy:
      property: domain
      direction: ASC
    order:
      - file.name
      - code
      - platform
      - actor
      - entity
      - status
  - type: table
    name: Impact by entity
    filters:
      and:
        - note.type == "feature"
    groupBy:
      property: entity
      direction: ASC
    order:
      - file.name
      - code
      - platform
      - status
  - type: table
    name: Test coverage
    filters:
      and:
        - note.type == "tc"
    order:
      - file.name
      - code
      - tc_total
      - tc_automated
      - status
